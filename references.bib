@article{ghiorzi_learning_2023,
	title = {Learning Linear Temporal Properties for Autonomous Robotic Systems},
	volume = {8},
	issn = {2377-3766},
	url = {https://ieeexplore.ieee.org/document/10087331/},
	doi = {10.1109/LRA.2023.3263368},
	abstract = {The problem of passive learning of linear temporal logic formulae consists in finding the best explanation for how two sets of execution traces differ, in the form of the shortest formula that separates the two sets. We approach the problem by implementing an exhaustive search algorithm optimized for execution speed. We apply it to the use-case of a robot moving in an unstructured environment as its battery discharges, both in simulation and in the real world. The results of our experiments confirm that our approach can learn temporal formulas explaining task failures in a case of practical interest.},
	pages = {2930--2937},
	number = {5},
	journaltitle = {{IEEE} Robotics and Automation Letters},
	author = {Ghiorzi, Enrico and Colledanchise, Michele and Piquet, Gianluca and Bernagozzi, Stefano and Tacchella, Armando and Natale, Lorenzo},
	urldate = {2025-09-09},
	date = {2023-05},
	keywords = {Cost accounting, Formal methods in robotics and automation, Reactive power, Robots, Search problems, Skeleton, Syntactics, Task analysis, autonomous agents, failure detection and recovery},
}

@article{camacho_learning_2019,
	title = {Learning Interpretable Models Expressed in Linear Temporal Logic},
	volume = {29},
	rights = {Copyright (c) 2019 Association for the Advancement of Artificial Intelligence},
	issn = {2334-0843},
	url = {https://ojs.aaai.org/index.php/ICAPS/article/view/3529},
	doi = {10.1609/icaps.v29i1.3529},
	abstract = {We examine the problem of learning models that characterize the high-level behavior of a system based on observation traces. Our aim is to develop models that are human interpretable. To this end, we introduce the problem of learning a Linear Temporal Logic ({LTL}) formula that parsimoniously captures a given set of positive and negative example traces. Our approach to learning {LTL} exploits a symbolic state representation, searching through a space of labeled skeleton formulae to construct an alternating automaton that models observed behavior, from which the {LTL} can be read off. Construction of interpretable behavior models is central to a diversity of applications related to planning and plan recognition. We showcase the relevance and significance of our work in the context of behavior description and discrimination: i) active learning of a human-interpretable behavior model that describes observed examples obtained by interaction with an oracle; ii) passive learning of a classifier that discriminates individual agents, based on the human-interpretable signature way in which they perform particular tasks. Experiments demonstrate the effectiveness of our symbolic model learning approach in providing human-interpretable models and classifiers from reduced example sets.},
	pages = {621--630},
	journaltitle = {Proceedings of the International Conference on Automated Planning and Scheduling},
	author = {Camacho, Alberto and {McIlraith}, Sheila A.},
	urldate = {2025-09-09},
	date = {2019-07-05},
	langid = {english},
}

@inproceedings{neider_learning_2018,
	title = {Learning Linear Temporal Properties},
	url = {https://ieeexplore.ieee.org/document/8603016},
	doi = {10.23919/FMCAD.2018.8603016},
	abstract = {We present two novel algorithms for learning formulas in Linear Temporal Logic ({LTL}) from examples. The first learning algorithm reduces the learning task to a series of satisfiability problems in propositional Boolean logic and produces a smallest {LTL} formula (in terms of the number of subformulas) that is consistent with the given data. Our second learning algorithm, on the other hand, combines the {SAT}-based learning algorithm with classical algorithms for learning decision trees. The result is a learning algorithm that scales to real-world scenarios with hundreds of examples, but can no longer guarantee to produce minimal consistent {LTL} formulas. We compare both learning algorithms and demonstrate their performance on a wide range of synthetic benchmarks. Additionally, we illustrate their usefulness on the task of understanding executions of a leader election protocol.},
	eventtitle = {2018 Formal Methods in Computer Aided Design ({FMCAD})},
	pages = {1--10},
	booktitle = {2018 Formal Methods in Computer Aided Design ({FMCAD})},
	author = {Neider, Daniel and Gavran, Ivan},
	urldate = {2025-09-09},
	date = {2018-10},
	keywords = {Classification algorithms, Decision trees, Learning automata, Model checking, Standards, Syntactics, Task analysis},
}

@article{walke_learning_2021,
	title = {Learning Finite Linear Temporal Logic Specifications with a Specialized Neural Operator},
	url = {https://www.semanticscholar.org/paper/Learning-Finite-Linear-Temporal-Logic-with-a-Neural-Walke-Ritter/05b47b3a71f2c24bba8ffa9246998cf9a2f968d2},
	abstract = {Finite linear temporal logic (\${\textbackslash}mathsf\{{LTL}\}\_f\$) is a powerful formal representation for modeling temporal sequences. We address the problem of learning a compact \${\textbackslash}mathsf\{{LTL}\}\_f\$ formula from labeled traces of system behavior. We propose a novel neural network operator and evaluate the resulting architecture, Neural\${\textbackslash}mathsf\{{LTL}\}\_f\$. Our approach includes a specialized recurrent filter, designed to subsume \${\textbackslash}mathsf\{{LTL}\}\_f\$ temporal operators, to learn a highly accurate classifier for traces. Then, it discretizes the activations and extracts the truth table represented by the learned weights. This truth table is converted to symbolic form and returned as the learned formula. Experiments on randomly generated \${\textbackslash}mathsf\{{LTL}\}\_f\$ formulas show Neural\${\textbackslash}mathsf\{{LTL}\}\_f\$ scales to larger formula sizes than existing approaches and maintains high accuracy even in the presence of noise.},
	journaltitle = {{ArXiv}},
	author = {Walke, H. and Ritter, Daniel and Trimbach, Carl and Littman, Michael S.},
	urldate = {2025-09-08},
	date = {2021-11-07},
}

@misc{silvetti_robust_2017,
	title = {A Robust Genetic Algorithm for Learning Temporal Specifications from Data},
	url = {http://arxiv.org/abs/1711.06202},
	doi = {10.48550/arXiv.1711.06202},
	abstract = {We consider the problem of mining signal temporal logical requirements from a dataset of regular (good) and anomalous (bad) trajectories of a dynamical system. We assume the training set to be labeled by human experts and that we have access only to a limited amount of data, typically noisy. We provide a systematic approach to synthesize both the syntactical structure and the parameters of the temporal logic formula using a two-steps procedure: first, we leverage a novel evolutionary algorithm for learning the structure of the formula, second, we perform the parameter synthesis operating on the statistical emulation of the average robustness for a candidate formula w.r.t. its parameters. We test our algorithm on a anomalous trajectory detection problem of a naval surveillance system and we compare our results with our previous work{\textasciitilde}{\textbackslash}cite\{{BufoBSBLB}14\} and with a recently proposed decision-tree{\textasciitilde}{\textbackslash}cite\{bombara\_decision\_2016\} based method. Our experiments indicate that the proposed approach outperforms our previous work w.r.t. accuracy and show that it produces in general smaller and more compact temporal logic specifications w.r.t. the decision-tree based approach with a comparable speed and accuracy.},
	number = {{arXiv}:1711.06202},
	publisher = {{arXiv}},
	author = {Silvetti, Simone and Nenzi, Laura and Bortolussi, Luca and Bartocci, Ezio},
	urldate = {2025-09-18},
	date = {2017-11-13},
	eprinttype = {arxiv},
	eprint = {1711.06202 [cs]},
	note = {version: 1},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Logic in Computer Science},
}

@inproceedings{hariharan_maximum_2023,
	location = {Cham},
	title = {Maximum Satisfiability of Mission-Time Linear Temporal Logic},
	isbn = {978-3-031-42626-1},
	doi = {10.1007/978-3-031-42626-1_6},
	abstract = {Mission-time Linear Temporal Logic ({MLTL}) is a variant of Linear Temporal Logic ({LTL}) with finite interval bounds on temporal operators, and is a popular formal specification language for safety-critical cyber-physical systems. Given a set of specifications, the maximum satisfiability problem ({MaxSAT}) asks to find the maximum number of simultaneously satisfiable specifications. {MaxSAT} is useful for system designing complex systems, e.g., system design and feature prioritization. Considering the significant advances in {MaxSAT} for Boolean logic, we develop translations from {MLTL} to Boolean logic to solve the {MLTL} {MaxSAT} problem. Given an {MLTL} formula \$\${\textbackslash}varphi \$\$φof length \$\${\textbar}{\textbackslash}varphi {\textbar}\$\${\textbar}φ{\textbar}with maximum interval length m, our first (recursive) translator runs in \$\${\textbackslash}mathcal O(m{\textasciicircum}\{{\textbar}{\textbackslash}varphi {\textbar}\})\$\$O(m{\textbar}φ{\textbar})time. Our second, improved (iterative) translator runs in \$\${\textbackslash}mathcal O({\textbar}{\textbackslash}varphi {\textbar}{\textasciicircum}2m{\textasciicircum}2)\$\$O({\textbar}φ{\textbar}2m2)time. Performance tests of satisfiability checks on {MaxSAT} instances illustrate that these Boolean translations perform significantly better than the best satisfiability checking approaches reported recently in the literature on real and random instances. Furthermore, the second translator is embarrassingly parallelizable to a factor of \$\${\textbar}{\textbackslash}varphi {\textbar}m\$\${\textbar}φ{\textbar}m. We contribute to (1) an easy-to-implement translation from {MLTL} to Boolean logic that runs in \$\${\textbackslash}mathcal O(m{\textasciicircum}\{{\textbar}{\textbackslash}varphi {\textbar}\})\$\$O(m{\textbar}φ{\textbar})time, and (2) an efficient translation that runs in \$\${\textbackslash}mathcal O({\textbar}{\textbackslash}varphi {\textbar}{\textasciicircum}2m{\textasciicircum}2)\$\$O({\textbar}φ{\textbar}2m2)time, and prove their correctness and runtime. Lastly, (3) we consider examples of using Boolean {MaxSAT} solvers to solve the {MLTL} {MaxSAT} problem.},
	pages = {86--104},
	booktitle = {Formal Modeling and Analysis of Timed Systems},
	publisher = {Springer Nature Switzerland},
	author = {Hariharan, Gokul and Jones, Phillip H. and Rozier, Kristin Yvonne and Wongpiromsarn, Tichakorn},
	editor = {Petrucci, Laure and Sproston, Jeremy},
	date = {2023},
	langid = {english},
}

@misc{romeo_metric_2018,
	title = {A Metric for Linear Temporal Logic},
	url = {http://arxiv.org/abs/1812.03923},
	doi = {10.48550/arXiv.1812.03923},
	abstract = {We propose a measure and a metric on the sets of infinite traces generated by a set of atomic propositions. To compute these quantities, we first map properties to subsets of the real numbers and then take the Lebesgue measure of the resulting sets. We analyze how this measure is computed for Linear Temporal Logic ({LTL}) formulas. An implementation for computing the measure of bounded {LTL} properties is provided and explained. This implementation leverages {SAT} model counting and effects independence checks on subexpressions to compute the measure and metric compositionally.},
	number = {{arXiv}:1812.03923},
	publisher = {{arXiv}},
	author = {Romeo, Íñigo Íncer and Lohstroh, Marten and Iannopollo, Antonio and Lee, Edward A. and Sangiovanni-Vincentelli, Alberto},
	urldate = {2025-09-23},
